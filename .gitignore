# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# fvm: the pinned SDK is .fvmrc (committed); the downloaded SDK and symlink are not
.fvm/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# build_runner output: getting-started.md runs `dart run build_runner build -d`
# as a setup step, so generated code is rebuilt rather than committed
*.g.dart
*.freezed.dart
*.drift.dart

# drift_dev CLI output, regenerated by `make gen` from the committed fixtures
# in app/drift_schemas/. The fixtures themselves ARE committed - they are the
# only record of what an older version of a learner's file looks like.
app/lib/data/db/schema_versions.dart
app/test/db/generated/

# gen_l10n output: regenerated by `flutter pub get` (pubspec `generate: true`)
app/lib/l10n/generated/
app/l10n-untranslated.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
app/android/app/debug
app/android/app/profile
app/android/app/release

# Widget Preview related
.widget_preview/

# Secrets / local env
.env
.env.*
!.env.example

# Claude Code local settings
.claude/settings.local.json

# Design export archives (the unpacked folders are the source)
deutsch-plan-design-html/*.zip

# Golden failure output, written beside the goldens on a mismatch
app/test/golden/failures/
content/build/

# The four source workbooks. `content/manifest.yaml` points `make content` at
# them, and the built `app/assets/db/content.db` is what ships — CI says so
# where it checks for that file. The workbooks themselves stay local.
/data/

# tools/team.py: which agent works in this worktree (one per worktree, never shared)
.dp-agent
