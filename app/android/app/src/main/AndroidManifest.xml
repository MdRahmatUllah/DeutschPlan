<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The model downloads (FR-S2-06, model-manager.md). Debug and profile
         builds add INTERNET on their own, which is why its absence here went
         unnoticed: a release build could not fetch a byte. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The daily reminder. Android 13+ shows the permission dialog only for
         an app that declares this; FR-S2-05 asks when the switch goes on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The reminders are rescheduled after a reboot (#157). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- The mock exam's Speaking answer (FR-L12S-01): asked when the learner
         first taps Record, never before. The recording stays on the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- No foreground service (#611). WorkManager and background_downloader
         declare them, but the app never starts one: a download's tasks keep
         the default priority (never expedited, never a user-initiated job)
         and no Config.runInForeground is set, so WorkManager carries them
         on and pauses/resumes them. Without these, Play asks for no
         foreground-service declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" tools:node="remove"/>
    <!-- enableOnBackInvokedCallback is predictive back (navigation.md).
         Without it Android 13+ runs the legacy back handler and the swipe
         shows no preview of where it is going, however the Flutter side is
         written. -->
    <!-- No Android backup and no device-to-device copy (#607, BR-PRIV-02):
         progress and Speaking recordings stay on this phone, as the app
         promises. allowBackup covers Auto Backup; from Android 12 a device
         transfer ignores it, so dataExtractionRules excludes everything too,
         and fullBackupContent covers Android 11 and older. Export is the one
         way progress leaves the phone. -->
    <application
        android:label="Sogda"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- sogda:// — the reminder notification and the home
                 screen widget (navigation.md, notifications-widget.md).
                 A private scheme with no host filter: nothing on the web
                 serves it, and BROWSABLE is what lets the widget's intent
                 reach the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sogda"/>
            </intent-filter>
        </activity>
        <!-- "Share → Sogda" with text (#1227), a PDF (#1228) or photos
             (#1332): a window-less trampoline that hands the share to
             MainActivity in the app's own task. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <!-- #1228: a PDF, its text layer read on the phone. -->
                <data android:mimeType="application/pdf"/>
                <!-- #1332: a photo, read as a chosen one is. -->
                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- #1332: several photos, a page each, up to 30. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <!-- X1, the home-screen widget (#160): Glance, drawn from the snapshot
             the app writes, redrawn when the app asks (widget.md). -->
        <receiver
            android:name=".widget.SogdaWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sogda_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_local_notifications: shows a scheduled reminder, and puts
         the schedule back after a reboot or an update (#157). Inexact
         alarms, so no exact-alarm permission. -->
    <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
    <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED"/>
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
        </intent-filter>
    </receiver>
    <!-- Kept declared, with no foreground-service type (#611). -->
    <!-- BR-PRIV-01 (#1229): ML Kit's text recognition reads the pages here,
         but its SDK also queues usage metrics for Google through
         DataTransport's Clearcut backend, a network call no user action
         makes. Without the backend's discovery and its schedulers, the
         events have nowhere to go and nothing is sent. -->
    <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove"/>
    <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove"/>
    <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove"/>
    <service android:name="androidx.work.impl.foreground.SystemForegroundService"
        tools:remove="android:foregroundServiceType"/>
    <service android:name="com.bbflight.background_downloader.UIDTJobService"
        tools:remove="android:foregroundServiceType"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The system voice (tts.md). Android 11+ hides TTS engines from an
             app that does not ask to see them, and flutter_tts then finds no
             German voice on a phone that has one. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Web links: T2's "Report a problem", and the dictionary links.
             Android 11+ will not say a browser can open them otherwise. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
