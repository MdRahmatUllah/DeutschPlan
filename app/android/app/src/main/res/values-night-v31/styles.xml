<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ SplashScreen API.

     The field colour and the mark are S1's, so the hand-off to Flutter's
     first frame changes neither colour nor mark. Android sizes the icon
     itself: its 288 dp canvas, masked to the inner 192 dp circle. So
     `splash_icon.xml` keeps the brand kit's 108 grid on that canvas, and S1
     draws the tiles at the same scale, at the screen's centre, where this
     lands (#602). `windowSplashScreenIconBackgroundColor` is deliberately
     unset, so no circle appears behind the tiles. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/splash_field</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- The template used `Theme.Light.NoTitleBar`. Switching to DayNight
             for the splash dropped that, and Android drew its own title bar
             with the package name across the top of every screen — which no
             widget test can see and the first device screenshot showed at
             once. There is no `DayNight.NoActionBar` platform style, so the
             two attributes are set directly. -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
