<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch window: the Lagoon field with the mark centred, which
     is the composition Flutter's first frame draws. Android 12 and up use
     `values-v31/styles.xml` instead, where the platform owns the icon's size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_field" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
