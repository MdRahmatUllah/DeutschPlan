<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of Sogda's goes to a cloud backup or to a new phone
     (#607, BR-PRIV-02). Every domain is excluded in both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
