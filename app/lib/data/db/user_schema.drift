-- user.db — the learner's data, and the authoritative DDL.
--
-- This is a drift file, so it is both the schema and the source drift
-- generates typed table classes from. user-database.md originally called for
-- a .sql asset mirrored by hand-written Dart tables; one file that is both
-- removes the mirror and the chance of the two drifting apart. See ADR 22.
--
-- It is still plain SQL, so anything that wants the raw DDL can read it.
--
-- Everything here lives on the device and leaves it only through the learner's
-- own export (BR-PRIV-02). There is no account and no server.
--
-- Dates: plan dates are ISO date strings 'YYYY-MM-DD' in LOCAL time, because a
-- study day is a local day. Timestamps are UTC ISO-8601. That split is in
-- docs/05-dev-guide/coding-standards.md and the column names say which is which.

-- Migration bookkeeping is SQLite's own `PRAGMA user_version`, which drift
-- writes on every migration. user-database.md called for a schema_version
-- table beside it; that table would be a second copy of one number, kept in
-- step by hand, and drift derives a `schemaVersion` accessor from the name
-- that collides with its own. The pragma answers the same question —
-- `sqlite3 user.db 'PRAGMA user_version'` — without either problem. ADR 23.

-- Every preference, as text. Typing happens in SettingsRepository (#62), which
-- owns the defaults table in user-database.md.
CREATE TABLE settings (
  "key" TEXT PRIMARY KEY NOT NULL,
  value TEXT NOT NULL
);

-- Steps the learner has started. Exactly one row has completed_on IS NULL and
-- that is the active step (BR-COURSE-04).
CREATE TABLE enrollments (
  sublevel_code   TEXT PRIMARY KEY NOT NULL,
  started_on      TEXT NOT NULL,
  daily_new       INTEGER NOT NULL,
  study_days_mask INTEGER NOT NULL,
  completed_on    TEXT
);

-- BR-COURSE-04: at most one open enrollment, which is the active step. Unique
-- on a constant rather than on completed_on, because SQLite treats every NULL
-- in a unique index as distinct and would allow any number of open rows.
CREATE UNIQUE INDEX idx_one_active_enrollment
  ON enrollments ((1)) WHERE completed_on IS NULL;

-- Per-word learning state. status is derived from stability, never set by hand
-- (BR-STATUS-02); card_mode switches to 'cloze' after two consecutive >= Good
-- (BR-FSRS-06).
CREATE TABLE word_state (
  word_uid      TEXT PRIMARY KEY NOT NULL,
  status        TEXT    NOT NULL DEFAULT 'todo',
  introduced_on TEXT,
  due           TEXT,
  stability     REAL    NOT NULL DEFAULT 0,
  difficulty    REAL    NOT NULL DEFAULT 0,
  reps          INTEGER NOT NULL DEFAULT 0,
  lapses        INTEGER NOT NULL DEFAULT 0,
  fsrs_state    INTEGER NOT NULL DEFAULT 0,
  last_review   TEXT,
  card_mode     TEXT    NOT NULL DEFAULT 'plain',
  times_logged  INTEGER NOT NULL DEFAULT 0,
  note          TEXT,
  CHECK (status IN ('todo', 'learning', 'done', 'suspended')),
  CHECK (card_mode IN ('plain', 'cloze'))
);

CREATE INDEX idx_word_state_due ON word_state (due);
CREATE INDEX idx_word_state_status ON word_state (status);

-- Every rating ever given. Never deleted: it is the input for stats and for the
-- FSRS weight optimisation the docs defer past v1.
CREATE TABLE review_log (
  id             INTEGER PRIMARY KEY AUTOINCREMENT,
  word_uid       TEXT    NOT NULL,
  reviewed_at    TEXT    NOT NULL,
  rating         INTEGER NOT NULL,
  source         TEXT    NOT NULL,
  elapsed_days   INTEGER NOT NULL DEFAULT 0,
  scheduled_days INTEGER NOT NULL DEFAULT 0,
  CHECK (rating BETWEEN 1 AND 4),
  CHECK (source IN ('daily', 'quiz', 'exam', 'search', 'known', 'sentence'))
);

CREATE INDEX idx_review_log_word ON review_log (word_uid);
CREATE INDEX idx_review_log_at ON review_log (reviewed_at);

-- The daily plan. An open 'new' row with plan_date < today is the backlog
-- (BR-PLAN-05), which is why there is no separate backlog table.
CREATE TABLE plan_items (
  plan_date     TEXT    NOT NULL,
  word_uid      TEXT    NOT NULL,
  kind          TEXT    NOT NULL,
  sublevel_code TEXT    NOT NULL,
  completed_at  TEXT,
  skipped       INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (plan_date, word_uid, kind),
  CHECK (kind IN ('new', 'revise'))
);

CREATE INDEX idx_plan_items_date ON plan_items (plan_date);
CREATE INDEX idx_plan_items_backlog
  ON plan_items (kind, completed_at, plan_date);

-- Grammar scheduling, with the same FSRS fields as words (BR-FSRS-05).
CREATE TABLE grammar_state (
  grammar_uid TEXT PRIMARY KEY NOT NULL,
  status      TEXT    NOT NULL DEFAULT 'todo',
  due         TEXT,
  stability   REAL    NOT NULL DEFAULT 0,
  difficulty  REAL    NOT NULL DEFAULT 0,
  reps        INTEGER NOT NULL DEFAULT 0,
  lapses      INTEGER NOT NULL DEFAULT 0,
  last_review TEXT,
  CHECK (status IN ('todo', 'learning', 'done', 'suspended'))
);

CREATE INDEX idx_grammar_state_due ON grammar_state (due);

CREATE TABLE grammar_practice_log (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  grammar_uid  TEXT    NOT NULL,
  practised_at TEXT    NOT NULL,
  items        INTEGER NOT NULL,
  correct      INTEGER NOT NULL
);

-- Which example sentences have been shown, so they do not repeat inside
-- sentence_repeat_gap_days.
CREATE TABLE sentence_log (
  word_uid    TEXT    NOT NULL,
  ord         INTEGER NOT NULL,
  shown_on    TEXT    NOT NULL,
  self_rating INTEGER,
  PRIMARY KEY (word_uid, ord, shown_on),
  CHECK (self_rating IS NULL OR self_rating BETWEEN 1 AND 3)
);

CREATE TABLE quiz_attempts (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  started_at   TEXT    NOT NULL,
  finished_at  TEXT,
  direction    TEXT    NOT NULL,
  source       TEXT    NOT NULL,
  source_ref   TEXT,
  seed         INTEGER NOT NULL,
  length       INTEGER NOT NULL,
  score_points REAL    NOT NULL DEFAULT 0,
  max_points   REAL    NOT NULL DEFAULT 0
);

CREATE TABLE quiz_answers (
  attempt_id INTEGER NOT NULL REFERENCES quiz_attempts (id) ON DELETE CASCADE,
  ord        INTEGER NOT NULL,
  word_uid   TEXT    NOT NULL,
  prompt     TEXT    NOT NULL,
  expected   TEXT    NOT NULL,
  given      TEXT,
  verdict    TEXT,
  points     REAL    NOT NULL DEFAULT 0,
  re_asked   INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (attempt_id, ord),
  CHECK (verdict IS NULL
         OR verdict IN ('correct', 'almost', 'wrongArticle', 'wrong'))
);

-- Mock exams. Leaving one sets status 'abandoned' and keeps the answers
-- (FR-L12-04); duration_sec accumulates only while the timer runs.
CREATE TABLE exam_attempts (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  sublevel_code TEXT    NOT NULL,
  seed          INTEGER NOT NULL,
  started_at    TEXT    NOT NULL,
  finished_at   TEXT,
  paused_sec    INTEGER NOT NULL DEFAULT 0,
  duration_sec  INTEGER NOT NULL DEFAULT 0,
  score_points  REAL    NOT NULL DEFAULT 0,
  max_points    REAL    NOT NULL DEFAULT 0,
  passed        INTEGER NOT NULL DEFAULT 0,
  status        TEXT    NOT NULL DEFAULT 'in_progress',
  CHECK (status IN ('in_progress', 'finished', 'abandoned')),
  CHECK (seed BETWEEN 1 AND 3)
);

CREATE INDEX idx_exam_attempts_step
  ON exam_attempts (sublevel_code, seed, status);

-- Answer rows are pre-inserted when the attempt is created, so a crash resumes
-- exactly and loses at most the answer being typed (FR-L12-01).
CREATE TABLE exam_answers (
  attempt_id       INTEGER NOT NULL REFERENCES exam_attempts (id) ON DELETE CASCADE,
  ord              INTEGER NOT NULL,
  section          TEXT    NOT NULL,
  item_ref         TEXT,
  prompt           TEXT    NOT NULL,
  options_json     TEXT,
  expected         TEXT,
  given            TEXT,
  flagged          INTEGER NOT NULL DEFAULT 0,
  points           REAL    NOT NULL DEFAULT 0,
  self_rubric_json TEXT,
  PRIMARY KEY (attempt_id, ord)
);

-- Words met in real life. matched_uid is set when the word turns out to be in
-- the course already (FR-R2-01).
CREATE TABLE custom_words (
  id          INTEGER PRIMARY KEY AUTOINCREMENT,
  created_at  TEXT    NOT NULL,
  article     TEXT,
  german      TEXT    NOT NULL,
  meaning     TEXT    NOT NULL,
  where_seen  TEXT,
  example     TEXT,
  matched_uid TEXT,
  times_seen  INTEGER NOT NULL DEFAULT 1
);

-- Per-day totals for the streak and the charts. A rest day with no activity has
-- no row, which is what the streak rule in plan-engine.md expects.
CREATE TABLE daily_stats (
  day             TEXT PRIMARY KEY NOT NULL,
  new_done        INTEGER NOT NULL DEFAULT 0,
  reviews_done    INTEGER NOT NULL DEFAULT 0,
  grammar_done    INTEGER NOT NULL DEFAULT 0,
  sentences_done  INTEGER NOT NULL DEFAULT 0,
  seconds         INTEGER NOT NULL DEFAULT 0,
  completed_shown INTEGER NOT NULL DEFAULT 0
);

-- Drives Today's one-time update card while seen = 0 (BR-CONTENT-03).
CREATE TABLE content_updates (
  version      TEXT PRIMARY KEY NOT NULL,
  added        INTEGER NOT NULL DEFAULT 0,
  removed      INTEGER NOT NULL DEFAULT 0,
  changed_json TEXT,
  seen         INTEGER NOT NULL DEFAULT 0
);

-- Excluded from export: it is a cache, and it is large.
CREATE TABLE translation_cache (
  src_lang   TEXT NOT NULL,
  tgt_lang   TEXT NOT NULL,
  src_text   TEXT NOT NULL,
  model      TEXT NOT NULL,
  result     TEXT NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY (src_lang, tgt_lang, src_text, model)
);

-- Also excluded from export. Trimmed to 20 rows.
CREATE TABLE undo_stack (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  created_at   TEXT NOT NULL,
  payload_json TEXT NOT NULL
);
