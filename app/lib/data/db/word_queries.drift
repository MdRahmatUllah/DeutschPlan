import 'content_schema.drift';
import 'user_schema.drift';

-- Every read that joins the course to the learner's progress.
--
-- One query, not two: the Words tab draws a row per word with its status
-- chip, and fetching the state separately would be a second round trip per
-- screen — or, worse, per row.
--
-- `word_state` is LEFT joined throughout. A word the learner has never met has
-- no row at all, and that is `todo` (BR-STATUS-01) rather than missing data.
--
-- **The status is derived here, not read from the column.** BR-STATUS-02 says
-- `done` comes from stability against `done_stability_days`, and that setting
-- is one the learner moves. Reading the stored column would leave every list
-- showing the status a word had when it was last rated, so lowering the
-- threshold would change nothing until each word happened to come round
-- again. `:doneAfter` is that setting, passed in by the repository.
--
-- The stored column is still written — `refreshStatus` keeps it current for
-- anything that reads `word_state` directly, and the CHECK constraint keeps
-- it honest — but nothing on screen depends on it being fresh.

wordsWithStateForStep:
  SELECT w.**, s.**, CASE
    WHEN s.status = 'suspended' THEN 'suspended'
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.sublevel_code = :code
  ORDER BY w.seq_in_sublevel;

-- R1's results: the words a search found, with their state, in no order —
-- the search ranks them, and the repository puts them back in its order.
wordsWithStateByUids:
  SELECT w.**, s.**, CASE
    WHEN s.status = 'suspended' THEN 'suspended'
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.uid IN :uids;

-- The same, minus suspended. BR-STATUS-03: suspended words are out of plans,
-- revision, quizzes, exams and practice sentences until resumed.
learnableWordsForStep:
  SELECT w.**, s.**, CASE
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.sublevel_code = :code
    AND (s.status IS NULL OR s.status != 'suspended')
  ORDER BY w.seq_in_sublevel;

-- A category, across every step. `categories.md`: ordered by step, then
-- frequency, then reading order.
wordsWithStateForCategory:
  SELECT w.**, s.**, CASE
    WHEN s.status = 'suspended' THEN 'suspended'
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  JOIN sublevels sub ON sub.code = w.sublevel_code
  WHERE w.category_id = :category
  ORDER BY sub.ord, w.freq DESC, w.seq;

-- FR-L5-01: every category that has words, its words by status as
-- stepProgress derives them, the biggest first (as L2's chips). One grouped
-- query rather than one per card.
categoryProgress:
  SELECT
    k.id AS id,
    k.name AS name,
    COUNT(*) AS total,
    COALESCE(SUM(CASE WHEN s.word_uid IS NULL THEN 1
      WHEN s.status != 'suspended' AND s.introduced_on IS NULL
        AND s.reps = 0 THEN 1 ELSE 0 END), 0) AS todo,
    COALESCE(SUM(CASE WHEN s.status != 'suspended'
      AND NOT (s.introduced_on IS NULL AND s.reps = 0)
      AND s.stability < :doneAfter THEN 1 ELSE 0 END), 0) AS learning,
    COALESCE(SUM(CASE WHEN s.status != 'suspended'
      AND NOT (s.introduced_on IS NULL AND s.reps = 0)
      AND s.stability >= :doneAfter THEN 1 ELSE 0 END), 0) AS done
  FROM categories k
  JOIN words w ON w.category_id = k.id
  LEFT JOIN word_state s ON s.word_uid = w.uid
  GROUP BY k.id
  ORDER BY total DESC, k.id;

wordWithState:
  SELECT w.**, s.**, CASE
    WHEN s.status = 'suspended' THEN 'suspended'
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.uid = :uid;

-- Everything due for revision today, across every step the learner has
-- started. `due` is a local date string, so the comparison is a string one.
dueWords:
  SELECT w.**, s.**, CASE
    WHEN s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0 THEN 'todo'
    WHEN COALESCE(s.stability, 0) >= :doneAfter THEN 'done'
    ELSE 'learning' END AS derived_status
  FROM word_state s
  JOIN words w ON w.uid = s.word_uid
  WHERE s.due IS NOT NULL AND s.due <= :today
    AND s.status != 'suspended'
  ORDER BY s.due, w.seq;

-- The counts the step list and Today draw. One row, four numbers: a COUNT per
-- status would be four scans of the same rows, and each one would have to
-- repeat the derivation above.
statusCountsForStep:
  SELECT
    COUNT(*) AS total,
    -- COALESCE because SUM over no rows is NULL, and a step with no words
    -- should report zero rather than make every caller handle a null.
    COALESCE(SUM(CASE WHEN s.status != 'suspended'
      AND s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0
      THEN 1 WHEN s.word_uid IS NULL THEN 1 ELSE 0 END), 0) AS todo,
    COALESCE(SUM(CASE WHEN s.status != 'suspended'
      AND NOT (s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0)
      AND COALESCE(s.stability, 0) < :doneAfter THEN 1 ELSE 0 END), 0)
      AS learning,
    COALESCE(SUM(CASE WHEN s.status != 'suspended'
      AND NOT (s.introduced_on IS NULL AND COALESCE(s.reps, 0) = 0)
      AND COALESCE(s.stability, 0) >= :doneAfter THEN 1 ELSE 0 END), 0)
      AS done,
    COALESCE(SUM(CASE WHEN s.status = 'suspended' THEN 1 ELSE 0 END), 0)
      AS suspended
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.sublevel_code = :code;

wordStateFor:
  SELECT * FROM word_state WHERE word_uid = :uid;

-- W1's history caption: how often the word was reviewed, from any source,
-- and the last rating it was given. The id breaks a tie in `reviewed_at`.
reviewHistory:
  SELECT COUNT(*) AS reviews,
    (SELECT rating FROM review_log
      WHERE word_uid = :uid ORDER BY reviewed_at DESC, id DESC LIMIT 1)
      AS last_rating
  FROM review_log WHERE word_uid = :uid;

-- FR-L1-01 / FR-M1-01 / FR-L2-01: the whole course, a row per step in
-- BR-COURSE-01's order. Its words by status, derived as in
-- statusCountsForStep; its grammar topics learned; the first mock passed
-- (BR-EXAM-04); and its enrollment, if it has one — `sublevel_code` is the
-- key, so a step has at most one. One grouped query rather than twelve.
stepProgress:
  SELECT
    sl.code AS code,
    sl.level_code AS level_code,
    sl.grammar_count AS grammar_count,
    COALESCE(w.total, 0) AS total,
    COALESCE(w.todo, 0) AS todo,
    COALESCE(w.learning, 0) AS learning,
    COALESCE(w.done, 0) AS done,
    (SELECT COUNT(*) FROM grammar_topics g
      JOIN grammar_state gs ON gs.grammar_uid = g.uid
      WHERE g.sublevel_code = sl.code
        AND gs.status IN ('learning', 'done')) AS grammar_learned,
    (SELECT a.seed FROM exam_attempts a
      WHERE a.sublevel_code = sl.code AND a.status = 'finished'
        AND a.passed = 1
      ORDER BY a.finished_at, a.id LIMIT 1) AS passed_seed,
    e.started_on AS started_on,
    e.completed_on AS completed_on,
    e.daily_new AS daily_new,
    e.study_days_mask AS study_days_mask
  FROM sublevels sl
  JOIN levels l ON l.code = sl.level_code
  LEFT JOIN enrollments e ON e.sublevel_code = sl.code
  LEFT JOIN (
    SELECT
      wd.sublevel_code AS sublevel_code,
      COUNT(*) AS total,
      SUM(CASE WHEN s.word_uid IS NULL THEN 1
        WHEN s.status != 'suspended' AND s.introduced_on IS NULL
          AND s.reps = 0 THEN 1 ELSE 0 END) AS todo,
      SUM(CASE WHEN s.status != 'suspended'
        AND NOT (s.introduced_on IS NULL AND s.reps = 0)
        AND s.stability < :doneAfter THEN 1 ELSE 0 END) AS learning,
      SUM(CASE WHEN s.status != 'suspended'
        AND NOT (s.introduced_on IS NULL AND s.reps = 0)
        AND s.stability >= :doneAfter THEN 1 ELSE 0 END) AS done
    FROM words wd
    LEFT JOIN word_state s ON s.word_uid = wd.uid
    GROUP BY wd.sublevel_code
  ) w ON w.sublevel_code = sl.code
  ORDER BY l.ord, sl.ord;

-- #81 (quiz-engine.md): the words a quiz draws from. Learned is learning or
-- done, which also leaves suspended words out (BR-STATUS-03). The store
-- narrows to a source's step, category or uids. `last_review` is a UTC
-- instant and the builder ranks in local days: the store takes its local
-- date, as the plan store's revision candidates do (#327). Not substr(…, 1,
-- 10), which is the UTC date.
quizWords:
  SELECT w.uid AS uid, w.german AS german, w.article AS article, w.pos AS pos,
    w.english AS english, w.bangla AS bangla, w.forms AS forms,
    w.sublevel_code AS step, w.category_id AS category_id,
    w.synonyms_register AS synonyms, s.stability AS stability,
    s.last_review AS reviewed
  FROM word_state s
  JOIN words w ON w.uid = s.word_uid
  WHERE s.status IN ('learning', 'done')
  ORDER BY w.seq;

-- A step's distractor pool: every word, whatever its status.
quizPool:
  SELECT w.uid AS uid, w.german AS german, w.article AS article, w.pos AS pos,
    w.english AS english, w.bangla AS bangla, w.sublevel_code AS step,
    w.synonyms_register AS synonyms
  FROM words w
  WHERE w.sublevel_code = :step
  ORDER BY w.seq;

-- FR-M3-01: what Settings' retention estimate sums over — every word that has
-- been rated and is not suspended. One never rated has no stability, and asks
-- for no review until it has one.
stabilitiesOfLearned:
  SELECT stability FROM word_state
  WHERE status <> 'suspended' AND stability > 0
  ORDER BY word_uid;

-- R1's idle (#138): the learner's own words, newest first.
myWords:
  SELECT * FROM custom_words ORDER BY created_at DESC, id DESC;
