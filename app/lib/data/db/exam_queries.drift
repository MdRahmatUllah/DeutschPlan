import 'content_schema.drift';
import 'user_schema.drift';

-- Mock exams and quizzes. One query per thing a screen asks for.

-- The attempt to resume. FR-L12-04 keeps an abandoned attempt's answers, so
-- `in_progress` is the only status the hub offers to continue.
inProgressExam:
  SELECT * FROM exam_attempts
  WHERE sublevel_code = :code AND status = 'in_progress'
  ORDER BY started_at DESC, id DESC
  LIMIT 1;

-- The same thing per seed. The hub has a card per mock (FR-L10-02), so one
-- answer for the whole step would leave a crashed Mock 1 showing *Start*
-- while Mock 2 was running.
inProgressBySeed:
  SELECT * FROM exam_attempts
  WHERE sublevel_code = :code AND status = 'in_progress'
  ORDER BY seed, started_at DESC, id DESC;

-- Where to put the learner back. `given IS NULL` rather than a stored cursor:
-- the answers are the record, and a cursor could disagree with them.
firstUnanswered:
  SELECT MIN(ord) AS ord FROM exam_answers
  WHERE attempt_id = :id AND given IS NULL;

answersFor:
  SELECT * FROM exam_answers WHERE attempt_id = :id ORDER BY ord;

-- What the exam hub draws: one row per seed that has been sat.
--
-- Attempts count everything that is no longer running, because FR-L12-04 says
-- an abandoned attempt shows as an attempt without a score, and because
-- BR-EXAM-02's *Try another mock* picks the next unused seed — a seed the
-- learner walked out of has been used. The score is finished-only
-- (FR-L10-02). `max_points` can be 0 on an attempt finished without grading,
-- so the division is guarded rather than left to produce a NULL best.
examSeedSummary:
  SELECT seed,
         COUNT(*) AS attempts,
         SUM(CASE WHEN status = 'finished' THEN 1 ELSE 0 END) AS finished,
         MAX(CASE WHEN status = 'finished' AND max_points > 0
                  THEN score_points * 100.0 / max_points
                  ELSE 0 END) AS best_percent,
         MAX(CASE WHEN status = 'finished' THEN passed ELSE 0 END)
           AS ever_passed
  FROM exam_attempts
  WHERE sublevel_code = :code AND status != 'in_progress'
  GROUP BY seed
  ORDER BY seed;

-- Passing marks the step: a query, not a flag (BR-EXAM).
stepPassed:
  SELECT EXISTS(
    SELECT 1 FROM exam_attempts
    WHERE sublevel_code = :code AND status = 'finished' AND passed = 1
  ) AS passed;

quizAnswersFor:
  SELECT * FROM quiz_answers WHERE attempt_id = :id ORDER BY ord;

-- The mistakes *Retry mistakes* and *Add mistakes to revision* work from.
quizMistakes:
  SELECT * FROM quiz_answers
  WHERE attempt_id = :id AND verdict IS NOT NULL AND verdict != 'correct'
  ORDER BY ord;

recentQuizzes:
  SELECT * FROM quiz_attempts
  WHERE finished_at IS NOT NULL
  ORDER BY finished_at DESC, id DESC
  LIMIT :limit;

-- L2's last quiz card: the step's latest finished quiz from its words.
lastStepQuiz:
  SELECT * FROM quiz_attempts
  WHERE source = 'stepLearned' AND source_ref = :code
    AND finished_at IS NOT NULL
  ORDER BY finished_at DESC, id DESC
  LIMIT 1;

-- #83 (exam-generator.md, step 1): what a step's mocks are built from. Its
-- words at any status but suspended, in course order.
examWords:
  SELECT w.uid AS uid, w.german AS german, w.article AS article, w.pos AS pos,
    w.english AS english, w.bangla AS bangla, w.forms AS forms,
    w.synonyms_register AS synonyms, w.category_id AS category_id
  FROM words w
  LEFT JOIN word_state s ON s.word_uid = w.uid
  WHERE w.sublevel_code = :step AND COALESCE(s.status, '') != 'suspended'
  ORDER BY w.seq;

-- Their example sentences, the gap fills' source.
examExamples:
  SELECT e.word_uid AS uid, e.german AS german, e.english AS english
  FROM word_examples e
  JOIN words w ON w.uid = e.word_uid
  WHERE w.sublevel_code = :step
  ORDER BY w.seq, e.ord;

-- The step's grammar topics, every one (the doc's pool).
examTopics:
  SELECT * FROM grammar_topics WHERE sublevel_code = :step ORDER BY seq;

-- The names of the categories the step's words fall in.
examCategories:
  SELECT c.id AS id, c.name AS name FROM categories c
  WHERE c.id IN (SELECT category_id FROM words WHERE sublevel_code = :step);

-- The writing check's connectors: the course's conjunctions up to and
-- including the step. `seq` is course order across levels, which the
-- per-level `sublevels.ord` is not.
examConnectors:
  SELECT w.german AS german FROM words w
  WHERE w.pos = 'conj'
    AND w.seq <= (SELECT MAX(seq) FROM words WHERE sublevel_code = :step)
  ORDER BY w.seq;
