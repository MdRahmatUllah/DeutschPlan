import 'content_schema.drift';

-- Every read of the course. `docs/02-data/content-database.md` gives the four
-- shapes; drift type-checks each one against `content_schema.drift` and
-- generates a typed row class, so a query naming a column that does not exist
-- is a build error rather than a crash on a learner's phone.
--
-- **The table names are unqualified, and that is deliberate.** The real tables
-- live in the attached schema `c`, and the doc writes `c.words`. drift cannot
-- type-check a schema prefix it has no declaration for, so these say `words`
-- and SQLite resolves it: `main` (user.db) has no table of that name, so the
-- search falls through to the attached database.
--
-- That resolution is load-bearing. `content_dao_test.dart` asserts no table
-- name exists in both schemas, because a `words` table added to user.db would
-- silently capture every one of these queries.

-- Search tier 1. `search.md`: search_key, search_key_alt, and the Bangla
-- meaning matched raw — a Bangla query is not normalised, so it has to hit the
-- column as typed.
--
-- Every search query takes L2's `:step` (null for the whole course) in SQL,
-- not after: filtered after the caps, a step keeps only its share of the
-- course-wide first rows.
exactMatches(:step AS TEXT OR NULL):
  SELECT * FROM words
  WHERE (search_key = :key OR search_key_alt = :alt OR bangla = :raw)
    AND (:step IS NULL OR sublevel_code = :step)
  ORDER BY freq DESC, seq;

-- Search tier 2. MATCH names the virtual table without a schema prefix, which
-- is what FTS5 requires; the query string is quoted and column-filtered by the
-- caller.
prefixMatches(:step AS TEXT OR NULL):
  SELECT w.**, f.rank AS rank FROM words w
  JOIN (
    SELECT uid, rank FROM words_fts WHERE words_fts MATCH :query
  ) f ON f.uid = w.uid
  WHERE :step IS NULL OR w.sublevel_code = :step
  ORDER BY f.rank
  LIMIT :limit;

-- Search tier 3. Candidates only: `search.md` filters these by edit distance
-- in Dart, because SQLite has no OSA distance and 400 rows is cheap to rank.
trigramCandidates(:step AS TEXT OR NULL):
  SELECT w.* FROM words w
  JOIN (
    SELECT uid FROM words_trigram WHERE words_trigram MATCH :query
  ) f ON f.uid = w.uid
  WHERE :step IS NULL OR w.sublevel_code = :step
  LIMIT :limit;

-- Search tier 4, "in sentences". The headword comes back with the sentence
-- because the result row shows it above.
--
-- `NULLIF` on the translation is not cosmetic: FTS5 columns carry no type, so
-- drift reads `e.english` as non-null and a sentence the workbook left
-- untranslated crashes the cast. Wrapping it makes the column nullable, which
-- is what `word_examples.english` already is.
--
-- `marked` is the sentence with each matched word between  and 
-- (FTS5's own `highlight()`), so R1 marks exactly what matched.
sentenceMatches(:step AS TEXT OR NULL):
  SELECT e.word_uid AS wordUid, e.german AS german,
         NULLIF(e.english, '') AS english,
         w.german AS head, w.article AS article, w.sublevel_code AS step,
         highlight(examples_fts, 1, char(1), char(2)) AS marked
  FROM examples_fts e
  JOIN words w ON w.uid = e.word_uid
  WHERE examples_fts MATCH :query
    AND (:step IS NULL OR w.sublevel_code = :step)
  ORDER BY e.rank
  LIMIT :limit;

wordByUid:
  SELECT * FROM words WHERE uid = :uid;

-- #1121: the words a search found by their meaning, within L2's :step.
wordsByUids(:step AS TEXT OR NULL):
  SELECT * FROM words
  WHERE uid IN :uids AND (:step IS NULL OR sublevel_code = :step);

examplesForWord:
  SELECT * FROM word_examples WHERE word_uid = :uid ORDER BY ord;

tipsForWord:
  SELECT * FROM interference_tips WHERE word_uid = :uid;

-- #1081: the meaning languages the course ships (#1080), in its order.
courseLanguageList:
  SELECT * FROM course_languages ORDER BY ord;

-- #1081: every shipped meaning and pronunciation, read once into
-- `CourseMeanings`: the lists (L2, L6, R1, T4) show a meaning a row.
allWordMeanings:
  SELECT word_uid, lang, meaning, pronunciation FROM word_meanings;

-- #1081: a word's example lines, each translated into :lang, or into
-- English where :lang has no examples of its own (Bangla, #598).
-- The word's lines first, so drift's parameters read (uid, lang).
examplesForWordIn(:uid AS TEXT, :lang AS TEXT):
  SELECT l.ord AS ord, l.german AS german,
         coalesce(t.translation, en.translation) AS translation
  FROM (SELECT ord, german FROM word_examples WHERE word_uid = :uid) l
  LEFT JOIN word_example_translations t
    ON t.word_uid = :uid AND t.ord = l.ord AND t.lang = :lang
  LEFT JOIN word_example_translations en
    ON en.word_uid = :uid AND en.ord = l.ord AND en.lang = 'en'
  ORDER BY l.ord;

-- #1081: a word's interference tips, one per language whose speakers have
-- one (#1080's `tip_<code>`).
wordTipsFor:
  SELECT lang, tip FROM word_tips WHERE word_uid = :uid;

-- #1081: the grammar topics the course has in :lang.
grammarTranslationsIn:
  SELECT * FROM grammar_translations WHERE lang = :lang;

-- W2 (#142): the course words a set's member may be — its own search key,
-- not a phrase, not another set — the set's step first, then the course's
-- order. `ContentDao.compareSet` takes the first that fits.
compareCandidates:
  SELECT * FROM words
  WHERE search_key = :key AND coalesce(pos, '') <> 'phrase'
    AND instr(german, ' / ') = 0
  ORDER BY sublevel_code = :step DESC, seq;

-- BR-COURSE-01's order: level first, then step. `content-database.md` gives
-- `sublevels.ord` as 1-12, but `PlanStore.stepAfter` was written against an
-- `ord` that restarts in each level, and ordering on it alone would then
-- interleave the levels. This is right under either.
allSublevels:
  SELECT s.*, l.name AS levelName, l.exam_target AS examTarget
  FROM sublevels s JOIN levels l ON l.code = s.level_code
  ORDER BY l.ord, s.ord;

contentMeta:
  SELECT value FROM meta WHERE "key" = :key;

-- M9 (#150): what About counts. meta keeps the word count; grammar topics
-- and example sentences are counted, as the pipeline's manifest counts them.
contentCounts:
  SELECT
    (SELECT COUNT(*) FROM words WHERE kind = 'vocab') AS word_total,
    (SELECT COUNT(*) FROM grammar_topics) AS grammar_total,
    (SELECT COUNT(*) FROM word_examples) AS sentence_total;
