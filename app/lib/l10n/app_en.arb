    "description": "S2 page 1, first promise."
  },
  "onboardingPromiseSteps": "Exam-structured: 12 steps from A1.1 to C2.2",
  "@onboardingPromiseSteps": {
    "description": "S2 page 1, second promise. A1.1 and C2.2 are step codes and are not translated."
  },
  "onboardingPromisePrivate": "Your progress stays on this phone",
  "@onboardingPromisePrivate": {
    "description": "S2 page 1, third promise."
  },
  "continueAction": "Continue",
  "@continueAction": {
    "description": "The primary action that moves to the next step."
  },
